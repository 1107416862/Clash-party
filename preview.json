  "proxy-groups": [
    {
      "name": "香港",
      "type": "url-test",
      "proxies": [
        "HK 01"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": 300,
      "lazy": false,
      "timeout": 5000,
      "expected-status": 204,
      "empty-fallback": "REJECT",
      "exclude-filter": "(?i)(剩余|流量|到期|过期|套餐|官网|网址|公告|重置|有效期|Traffic|Expire|Reset|DIRECT|REJECT)",
      "filter": "(?i)(香港|港仔|港岛|🇭🇰|(?:^|[^A-Za-z])HK(?:[^A-Za-z]|$)|Hong[ -]?Kong)",
      "tolerance": 50
